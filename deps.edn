;; clj-parinferish — parinfer for Clojure source, in pure Java. See README.md.
;;
;; No runtime dependencies: the engine is three java/ classes, src/ adds the
;; Clojure facade and `balance`, and neither reaches past clojure.core. Compile
;; the Java with `clojure -T:build compile-java` — it lands in target/classes,
;; which is on :paths for development and inside the published jar. Depend on
;; the Maven coordinate, never a git one.
{:paths ["src" "target/classes"]

 :deps {}

 :aliases
 {:build
  {:deps {io.github.clojure/tools.build {:mvn/version "0.10.9"}
          slipset/deps-deploy           {:mvn/version "0.2.5"}}
   :ns-default build}

  ;; The differential test reads the REAL upstream parinferish and asserts the two
  ;; agree on every file in this repo and on thousands of seeded mutations of them.
  ;; Test scope only: it never reaches a consumer.
  :test
  {:extra-paths ["test" "dev"]
   :extra-deps  {org.clojure/clojure {:mvn/version "1.12.4"}
                 parinferish/parinferish {:mvn/version "0.8.0"}
                 io.github.cognitect-labs/test-runner
                 {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :main-opts   ["-m" "cognitect.test-runner"]
   :exec-fn     cognitect.test-runner.api/test}

  ;; `clojure -M:bench` — the numbers in the README, against upstream.
  :bench
  {:extra-paths ["dev"]
   :extra-deps  {org.clojure/clojure {:mvn/version "1.12.4"}
                 parinferish/parinferish {:mvn/version "0.8.0"}}
   :main-opts   ["-m" "bench"]}

  ;; `clojure -M:fuzz <dir>... [mutations]` — the same differential the tests run,
  ;; pointed at any tree of Clojure source.
  :fuzz
  {:extra-paths ["dev"]
   :extra-deps  {org.clojure/clojure {:mvn/version "1.12.4"}
                 parinferish/parinferish {:mvn/version "0.8.0"}}
   :main-opts   ["-m" "fuzz"]}}}
